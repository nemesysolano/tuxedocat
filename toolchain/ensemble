#!/usr/bin/env bash

function prepare_folder {
    FOLDER=$1
    if [ ! -d "${FOLDER}"  ];
    then
        mkdir -p "$FOLDER"
    else
        rm -rf "${FOLDER}/*"
    fi    
}

SCRIPT_DIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]:-$0}"; )" &> /dev/null && pwd 2> /dev/null; )"
GENERATORS=("normalized-z" "estimated-stdev" "log-variance")
FILTERS=("gaussian" "hyperbolic-fractional")
ENSEMBLE_FOLDER=$(realpath "${SCRIPT_DIR}/../results/ensemble")
TOOLCHAIN_FOLDER=$(realpath "${SCRIPT_DIR}/../toolchain")
BIN_FOLDER=$(realpath "${SCRIPT_DIR}/../bin")
SIGNALS_FOLDER=$(realpath "${SCRIPT_DIR}/../results/signals")
PYTHON_ENV="${SCRIPT_DIR}/../pydevs"

GENERATE_INPUT=false

case "${1:-}" in
    --generate-input=*)
        GENERATE_INPUT="${1#*=}"
        shift
        ;;
    --generate-input)
        GENERATE_INPUT=true
        shift
        ;;
esac

if [ "${GENERATE_INPUT}" = "true" ]; then
    make -C "${SCRIPT_DIR}/.." __CLI_MAIN__=true -j8 || exit 1
    prepare_folder "$ENSEMBLE_FOLDER"

    for GENERATOR in "${GENERATORS[@]}"; do
        for FILTER in "${FILTERS[@]}"; do
            OUTPUT_FOLDER="${ENSEMBLE_FOLDER}/${GENERATOR}/${FILTER}"
            prepare_folder "$OUTPUT_FOLDER"
            "${BIN_FOLDER}/tuxedocat" play "${GENERATOR}" "${FILTER}" "${ENSEMBLE_DSN}" "${ENSEMBLE_UID}" "${ENSEMBLE_PWD}" "$OUTPUT_FOLDER"
            echo "Generated ensemble info ${GENERATOR} ${FILTER}"
        done
    done
fi

make __CLI_MAIN__=true __DEBUG__=true

if [ -x "${PYTHON_ENV}/bin/python" ]; then
    PYTHON="${PYTHON_ENV}/bin/python"
elif [ -x "${PYTHON_ENV}/Scripts/python.exe" ]; then
    PYTHON="${PYTHON_ENV}/Scripts/python.exe"
elif command -v python >/dev/null 2>&1; then
    PYTHON="$(command -v python)"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="$(command -v python3)"
else
    echo "Error: Python is required to run the ensemble." >&2
    exit 127
fi

exec "$PYTHON" "${TOOLCHAIN_FOLDER}/ensemble.py" "$@"
    